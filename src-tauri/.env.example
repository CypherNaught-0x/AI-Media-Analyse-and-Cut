# Copy this file to `.env` (in src-tauri/) to run the Real Pipeline integration tests.
# If these are unset or empty, the real pipeline tests are skipped automatically.

# API key for your Gemini / OpenAI-compatible provider.
TEST_API_KEY=your-api-key-here

# Base URL of the API endpoint (e.g. https://api.openai.com or a compatible endpoint).
TEST_BASE_URL=https://your-api-endpoint.example.com

# Model identifier to use for the tests.
TEST_MODEL=your-model-name
