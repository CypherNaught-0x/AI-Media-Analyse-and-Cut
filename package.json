{
  "name": "ai-media-cutter",
  "private": true,
  "version": "0.14.0",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/check-tauri-versions.js && vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "typecheck": "vue-tsc --noEmit && vue-tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:tauri-versions": "node scripts/check-tauri-versions.js",
    "version:bump": "node scripts/bump-version.js",
    "publish:tag": "git tag app-v$npm_package_version && git push --follow-tags",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@tauri-apps/api": "~2.10.0",
    "@tauri-apps/plugin-dialog": "~2.7.0",
    "@tauri-apps/plugin-fs": "~2.5.0",
    "@tauri-apps/plugin-opener": "~2.5.0",
    "@tauri-apps/plugin-process": "~2.3.0",
    "@tauri-apps/plugin-updater": "~2.10.0",
    "flag-icons": "^7.5.0",
    "vue": "^3.5.13",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.1.17",
    "@tauri-apps/cli": "^2",
    "@types/node": "^22",
    "@vitejs/plugin-vue": "^6.0.2",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "jsdom": "^27.2.0",
    "lefthook": "^2.1.17",
    "playwright": "^1.61.1",
    "postcss": "^8.5.6",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.1.17",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.2.7",
    "vite-svg-loader": "^5.1.0",
    "vitest": "^4.0.15",
    "vue-tsc": "^3.1.7"
  }
}
