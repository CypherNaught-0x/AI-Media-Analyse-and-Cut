{
  // Type-checks the specs as well. The app config excludes them so test-only
  // types (Node, the build scripts the specs import) stay out of the app build.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["node"],
    // The specs run on Node, which has ES2022 (Array.prototype.at, ...); the
    // app keeps the base lib. @types/node 26 no longer declares these itself.
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowJs": true
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "src/**/*.tsx", "src/**/*.vue"],
  "exclude": []
}
